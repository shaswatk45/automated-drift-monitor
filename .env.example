# .env.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in any values relevant to your environment.
# This file is safe to commit — it contains NO real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend ────────────────────────────────────────────────────────────────────
# Host and port for the FastAPI server (overrides configs/config.yaml)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ───────────────────────────────────────────────────────────────────
# The URL the frontend uses to reach the backend API.
# Leave empty in local dev (Vite proxy handles it).
# Set to the backend container URL in production Docker deployments.
# Example: VITE_API_URL=http://backend:8000
VITE_API_URL=http://localhost:8000
